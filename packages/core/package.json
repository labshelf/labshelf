{
  "name": "@labshelf/core",
  "version": "0.1.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p tools/pdf-eval",
    "eval:pdf": "node --import ./tools/pdf-eval/loader/registerTypeScript.mjs --no-warnings tools/pdf-eval/run.ts",
    "lint": "node ../../scripts/run-eslint.mjs && pnpm run lint:runtime",
    "lint:runtime": "node ../../scripts/check-runtime-tsconfigs.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "tokens": "WRITE_TOKENS=1 node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/ui"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@napi-rs/canvas": "^1.0.9",
    "mathjax-full": "3.2.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~6.3.289",
    "tesseract.js": "^7.0.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2",
    "typescript-js": "npm:typescript@^6.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom/index.ts",
    "./node": "./src/node/index.ts",
    "./math": "./src/writing/latex/math/index.ts",
    "./typst": "./src/writing/typst/index.ts",
    "./typst/node": "./src/writing/typst/node/index.ts",
    "./styles/reader.css": "./src/reader/dom/styles/reader.css",
    "./styles/preview.css": "./src/reader/dom/styles/preview.css",
    "./styles/base.css": "./src/ui/dom/base.css",
    "./styles/toast.css": "./src/ui/dom/widgets/toast.css",
    "./styles/arc-mark.css": "./src/ui/dom/widgets/arcMark.css",
    "./styles/settings.css": "./src/ui/dom/settings/settings.css",
    "./styles/library-ui.css": "./src/library-ui/dom/styles/library-ui.css",
    "./styles/library-list.css": "./src/library-ui/dom/styles/library-list.css",
    "./styles/library-detail.css": "./src/library-ui/dom/styles/library-detail.css",
    "./styles/library-tabs.css": "./src/library-ui/dom/styles/library-tabs.css",
    "./styles/library-citation-map.css": "./src/library-ui/dom/styles/library-citation-map.css",
    "./styles/template-gallery.css": "./src/writing/templates/dom/styles/template-gallery.css",
    "./styles/tokens.css": "./src/ui/dom/tokens.css",
    "./styles/vscodeHost.css": "./src/ui/dom/vscodeHost.css",
    "./test-support/sync-fakes": "./__tests__/support/syncFakes.ts",
    "./package.json": "./package.json"
  }
}
