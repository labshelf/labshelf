{
  "name": "@labshelf/core",
  "version": "0.1.0",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p tools/pdf-eval",
    "eval:pdf": "node --import ./tools/pdf-eval/loader/registerTypeScript.mjs --no-warnings tools/pdf-eval/run.ts",
    "lint": "node ../../scripts/lint/eslint.mjs && pnpm run lint:runtime && pnpm run lint:codicons",
    "lint:codicons": "node tools/codicons/generateCodicons.mjs --check",
    "codicons": "node tools/codicons/generateCodicons.mjs",
    "build:relay-worker": "node tools/relayWorker/bundleRelayWorker.mjs",
    "lint:runtime": "node ../../scripts/lint/runtimeTsconfigs.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "tokens": "WRITE_TOKENS=1 node --experimental-vm-modules node_modules/jest/bin/jest.js __tests__/ui"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@myriaddreamin/typst.ts": "0.7.0",
    "@napi-rs/canvas": "^1.0.9",
    "mathjax-full": "3.2.2",
    "node-diff3": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~6.3.289",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.3",
    "prosemirror-view": "^1.42.7",
    "tesseract.js": "^7.0.0",
    "y-codemirror.next": "^0.3.6",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yaml": "^2.7.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@vscode/codicons": "0.0.46-24",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2",
    "typescript-js": "npm:typescript@^6.0.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom/index.ts",
    "./node": "./src/node/index.ts",
    "./sourceEditor": "./src/writing/dom/sourceEditor/index.ts",
    "./math": "./src/latex/hover/index.ts",
    "./helper": "./src/helper/index.ts",
