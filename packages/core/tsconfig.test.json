{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "types": [
      "jest",
      "node"
    ],
    "noEmit": false,
    "rootDir": ".",
    "paths": {
      "@labshelf/core": [
        "./src/index.ts"
      ],
      "node-diff3": [
        "./node_modules/node-diff3/src/diff3.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "__tests__/**/*"
  ]
}
