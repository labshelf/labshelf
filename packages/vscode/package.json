{
  "name": "@labshelf/vscode",
  "displayName": "LabShelf",
  "description": "Local-first research operating system for VS Code.",
  "version": "0.0.1",
  "publisher": "labshelf",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/labshelf.yaml",
    "onLanguage:latex",
    "onLanguage:typst",
    "onUri",
    "onStartupFinished"
  ],
