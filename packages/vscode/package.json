    "viewsContainers": {
      "activitybar": [
        {
          "id": "labshelfContainer",
          "title": "LabShelf",
          "icon": "media/labshelf.svg"
        }
      ],
      "panel": [
        {
          "id": "labshelfSearch",
          "title": "Project Search",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "labshelfSearch": [
        {
          "id": "labshelf.writing.projectSearch",
          "name": "Project Search",
          "type": "webview",
          "when": "labshelf.writing.projectOpen || labshelf.writing.inProject"
        }
      ],
      "labshelfContainer": [
        {
          "id": "labshelf.library",
          "name": "LabShelf",
          "type": "webview"
        },
        {
          "id": "labshelf.writing.figures",
          "name": "Figures",
          "type": "tree",
          "when": "labshelf.writing.projectOpen && labshelf.writing.hasFigures",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "labshelf.addPaper",
          "when": "view == labshelf.library",
          "group": "1_add@0"
        },
        {
          "command": "labshelf.addPaperByIdentifier",
          "when": "view == labshelf.library",
          "group": "1_add@1"
        },
        {
          "command": "labshelf.newFolderAtRoot",
          "when": "view == labshelf.library",
          "group": "1_add@2"
        },
        {
          "command": "labshelf.library.refresh",
          "when": "view == labshelf.library",
          "group": "2_view@2"
        },
        {
          "command": "labshelf.showCitationMap",
          "when": "view == labshelf.library",
          "group": "2_view@1"
        },
        {
          "command": "labshelf.settingsMenu",
          "when": "view == labshelf.library",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "labshelf.writing.regenerateFigure",
          "when": "view == labshelf.writing.figures && viewItem == labshelfFigureStale",
          "group": "inline@1"
        },
        {
          "command": "labshelf.writing.regenerateFigure",
          "when": "view == labshelf.writing.figures && viewItem =~ /^labshelfFigure/",
          "group": "1_figure@1"
        }
      ],
      "commandPalette": [
        {
          "command": "labshelf.writing.revealOutline",
          "when": "false"
        },
        {
          "command": "labshelf.writing.checklist.runCheck",
          "when": "false"
        },
        {
          "command": "labshelf.writing.checklist.addItem",
          "when": "labshelf.writing.projectOpen"
        },
        {
          "command": "labshelf.writing.showInPreview",
          "when": "editorLangId == latex"
        },
        {
          "command": "labshelf.writing.bold",
          "when": "labshelf.writing.inProject"
        },
        {
          "command": "labshelf.writing.italic",
          "when": "labshelf.writing.inProject"
        },
        {
          "command": "labshelf.writing.citeFromLibrary",
          "when": "labshelf.writing.inProject && editorLangId =~ /^(latex|typst)$/"
        },
        {
          "command": "labshelf.writing.searchInProject",
          "when": "labshelf.writing.inProject && editorLangId =~ /^(latex|typst)$/"
        },
        {
          "command": "labshelf.writing.insertSymbol",
          "when": "labshelf.writing.inProject && editorLangId =~ /^(latex|typst)$/"
        },
        {
          "command": "labshelf.writing.insertTable",
          "when": "labshelf.writing.inProject && editorLangId =~ /^(latex|typst)$/"
        },
        {
          "command": "labshelf.writing.insertImage",
          "when": "labshelf.writing.inProject && editorLangId =~ /^(latex|typst)$/"
        },
        {
          "command": "labshelf.reader.zoomIn",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.zoomOut",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.zoomReset",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.find",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.historyBack",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.historyForward",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.toggleSidebar",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
