    "viewsContainers": {
      "activitybar": [
        {
          "id": "labshelfContainer",
          "title": "LabShelf",
          "icon": "media/labshelf.svg"
        }
      ]
    },
    "views": {
      "labshelfContainer": [
        {
          "id": "labshelf.library",
          "name": "Library",
          "type": "tree"
        },
        {
          "id": "labshelf.writing",
          "name": "Projects",
          "type": "tree",
          "when": "!labshelf.writing.projectOpen"
        },
        {
          "id": "labshelf.writing.files",
          "name": "Files",
          "type": "tree",
          "when": "labshelf.writing.projectOpen"
        },
        {
          "id": "labshelf.writing.outline",
          "name": "Outline",
          "type": "tree",
          "when": "labshelf.writing.projectOpen"
        },
        {
          "id": "labshelf.writing.figures",
          "name": "Figures",
          "type": "tree",
          "when": "labshelf.writing.projectOpen && labshelf.writing.hasFigures",
          "visibility": "collapsed"
        },
        {
          "id": "labshelf.settings",
          "name": "Settings",
          "type": "tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "labshelf.library",
        "contents": "Loading your library…",
        "when": "!labshelf.libraryLoaded"
      },
      {
        "view": "labshelf.library",
        "contents": "No folders yet.\n[New folder](command:labshelf.newFolder)\nYou can also drag PDFs here.",
        "when": "labshelf.libraryLoaded"
      },
      {
        "view": "labshelf.writing",
        "contents": "No projects yet.\n[New project](command:labshelf.writing.newProject)\n[Add existing folder](command:labshelf.writing.addExistingFolder)"
      },
      {
        "view": "labshelf.settings",
        "contents": "Library, Drive sync, preferences.\n[Change library folder](command:labshelf.configureLibrary)"
      },
      {
        "view": "labshelf.settings",
        "contents": "[Connect to Google Drive](command:labshelf.sync.connect)",
        "when": "!labshelf.driveConnected"
      },
      {
        "view": "labshelf.settings",
        "contents": "[Sync now](command:labshelf.sync.now)\n[Disconnect from Google Drive](command:labshelf.sync.disconnect)",
        "when": "labshelf.driveConnected"
      },
      {
        "view": "labshelf.settings",
        "contents": "Sync interval and AI options live in the VS Code settings.\n[Open settings](command:labshelf.openSettings)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "labshelf.writing.closeProject",
          "when": "view == labshelf.writing.files",
          "group": "navigation@0"
        },
        {
          "command": "labshelf.writing.newFile",
          "when": "view == labshelf.writing.files",
          "group": "navigation@1"
        },
        {
          "command": "labshelf.writing.newFolder",
          "when": "view == labshelf.writing.files",
          "group": "navigation@2"
        },
        {
          "command": "labshelf.addPaper",
          "when": "view == labshelf.library",
          "group": "navigation@1"
        },
        {
          "command": "labshelf.addPaperByIdentifier",
          "when": "view == labshelf.library",
          "group": "navigation@2"
        },
        {
          "command": "labshelf.newFolderAtRoot",
          "when": "view == labshelf.library",
          "group": "navigation@3"
        },
        {
          "command": "labshelf.library.refresh",
          "when": "view == labshelf.library",
          "group": "navigation@4"
        },
        {
          "command": "labshelf.showCitationMap",
          "when": "view == labshelf.library",
          "group": "navigation@5"
        },
        {
          "command": "labshelf.writing.newProject",
          "when": "view == labshelf.writing",
          "group": "navigation@1"
        },
        {
          "command": "labshelf.writing.addExistingFolder",
          "when": "view == labshelf.writing",
          "group": "navigation@2"
        },
        {
          "command": "labshelf.writing.refresh",
          "when": "view == labshelf.writing",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "labshelf.addPaperHere",
          "when": "view == labshelf.library && viewItem =~ /^labshelf(Folder|Root)$/",
          "group": "inline@1"
        },
        {
          "command": "labshelf.newFolder",
          "when": "view == labshelf.library && viewItem =~ /^labshelf(Folder|Root)$/",
          "group": "1_modify@1"
        },
        {
          "command": "labshelf.renameFolder",
          "when": "view == labshelf.library && viewItem == labshelfFolder",
          "group": "1_modify@2"
        },
        {
          "command": "labshelf.deleteFolder",
          "when": "view == labshelf.library && viewItem == labshelfFolder",
          "group": "1_modify@3"
        },
        {
          "command": "labshelf.writing.openProject",
          "when": "view == labshelf.writing && viewItem =~ /^labshelfProject(External)?$/",
          "group": "1_open@1"
        },
        {
          "command": "labshelf.writing.checkBeforeSubmitting",
          "when": "view == labshelf.writing && viewItem =~ /^labshelfProject(External)?$/",
          "group": "1_open@2"
        },
        {
          "command": "labshelf.writing.markVersion",
          "when": "view == labshelf.writing && viewItem =~ /^labshelfProject(External)?$/",
          "group": "1_open@4"
        },
        {
          "command": "labshelf.writing.compareVersions",
          "when": "view == labshelf.writing && viewItem =~ /^labshelfProject(External)?$/",
          "group": "1_open@5"
        },
        {
          "command": "labshelf.installProjectPapers",
          "when": "view == labshelf.writing && viewItem =~ /^labshelfProject(External)?$/",
          "group": "1_open@6"
        },
        {
          "command": "labshelf.writing.reveal",
          "when": "view == labshelf.writing && viewItem =~ /^labshelfProject/",
          "group": "1_open@3"
        },
        {
          "command": "labshelf.writing.removeProject",
          "when": "view == labshelf.writing && viewItem =~ /External$/",
          "group": "2_remove@1"
        },
        {
          "command": "labshelf.writing.regenerateFigure",
          "when": "view == labshelf.writing.figures && viewItem == labshelfFigureStale",
          "group": "inline@1"
        },
        {
          "command": "labshelf.writing.regenerateFigure",
          "when": "view == labshelf.writing.figures && viewItem =~ /^labshelfFigure/",
          "group": "1_figure@1"
        },
        {
          "command": "labshelf.writing.addToReadingList",
          "when": "view == labshelf.writing && viewItem =~ /^labshelfProject(External)?$/",
          "group": "3_reading@1"
        },
        {
          "command": "labshelf.writing.newFile",
          "when": "view == labshelf.writing.files && viewItem == labshelfProjectFolder",
          "group": "1_create@1"
        },
        {
          "command": "labshelf.writing.newFolder",
          "when": "view == labshelf.writing.files && viewItem == labshelfProjectFolder",
          "group": "1_create@2"
        },
        {
          "command": "labshelf.writing.renameFile",
          "when": "view == labshelf.writing.files && viewItem =~ /^labshelfProject(Folder|File)$/",
          "group": "2_modify@1"
        },
        {
          "command": "labshelf.writing.deleteFile",
          "when": "view == labshelf.writing.files && viewItem =~ /^labshelfProject(Folder|File)$/",
          "group": "2_modify@2"
        }
      ],
      "commandPalette": [
        {
          "command": "labshelf.writing.revealOutline",
          "when": "false"
        },
        {
          "command": "labshelf.writing.showInPreview",
          "when": "editorLangId == latex"
        },
        {
          "command": "labshelf.reader.zoomIn",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.zoomOut",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.zoomReset",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.find",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.historyBack",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.historyForward",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.reader.toggleSidebar",
          "when": "activeWebviewPanelId == 'labshelfPdf'"
        },
        {
          "command": "labshelf.writing.openProject",
          "when": "false"
        },
        {
          "command": "labshelf.writing.closeProject",
          "when": "labshelf.writing.projectOpen"
        },
        {
          "command": "labshelf.writing.newFile",
          "when": "false"
        },
        {
          "command": "labshelf.writing.newFolder",
          "when": "false"
        },
        {
          "command": "labshelf.writing.renameFile",
          "when": "false"
        },
        {
          "command": "labshelf.writing.deleteFile",
          "when": "false"
        },
        {
          "command": "labshelf.writing.reveal",
          "when": "false"
        },
        {
          "command": "labshelf.writing.removeProject",
          "when": "false"
        },
        {
          "command": "labshelf.writing.setMain",
          "when": "false"
        },
        {
          "command": "labshelf.writing.pickMain",
          "when": "false"
        },
        {
          "command": "labshelf.writing.pickCompiler",
          "when": "false"
        },
        {
          "command": "labshelf.writing.regenerateFigure",
          "when": "false"
        },
        {
          "command": "labshelf.writing.addToReadingList",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "labshelf.writing.showInPreview",
          "when": "editorLangId == latex",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "labshelf.writing.setMain",
          "when": "resourceExtname =~ /^\\.(tex|typ)$/",
          "group": "2_workspace@9"
        }
      ]
    },
    "configuration": {
      "title": "LabShelf",
      "properties": {
        "labshelf.sync.autoSyncIntervalMinutes": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "description": "Interval between automatic Google Drive syncs, in minutes."
        },
        "labshelf.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Index paper text so the Related tab can list similar papers."
        },
        "labshelf.ocr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Read a PDF optically when its text layer is missing or unreadable, so scanned papers and files with damaged fonts still yield metadata. Only runs when the text layer fails."
        },
        "labshelf.ocr.makeSearchable": {
          "type": "boolean",
          "default": true,
          "description": "After importing a scanned paper, read every page and add an invisible text layer so the PDF can be searched (Ctrl+F) and its text selected. The pages themselves are not altered. Runs in the background; requires labshelf.ocr.enabled. When off, scans are still detected and flagged in the library, and can be made searchable from the paper's details."
        },
        "labshelf.ocr.maxPages": {
          "type": "number",
          "default": 150,
          "minimum": 1,
          "description": "Scanned documents with more pages than this are not given a text layer automatically, since each page takes several seconds to read."
        },
        "labshelf.ocr.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "eng"
          ],
          "description": "Tesseract language codes used for OCR, for example [\"eng\", \"por\"]. Language data is downloaded once on first use."
        },
        "labshelf.reader.vimKeys": {
          "type": "boolean",
          "default": false,
          "description": "Enable single-key vim navigation in the PDF reader (j/k, d/u, gg/G, /, n/N, H/L, w, t). Conventional shortcuts stay active."
        },
        "labshelf.reader.defaultZoom": {
          "type": "string",
          "enum": [
            "page-width",
            "page-fit",
            "page-actual",
            "auto"
          ],
          "default": "page-width",
          "description": "Zoom applied when a paper is opened without a stored reading position, and by Reset Zoom."
        },
        "labshelf.reader.toolbarAutoHide": {
          "type": "boolean",
          "default": true,
          "description": "Hide the reader toolbar while scrolling down; it returns on scroll up, when the pointer nears the top, or on keyboard focus."
        },
        "labshelf.reader.restorePosition": {
          "type": "boolean",
          "default": true,
          "description": "Reopen each paper at the page, zoom and sidebar state where it was last read."
        },
        "labshelf.reader.hoverPreviews": {
          "type": "boolean",
          "default": true,
          "description": "Show a preview when hovering a citation, figure, equation, table or section link."
        },
        "labshelf.reader.hoverDelayMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay before a hover preview opens, in milliseconds."
        },
        "labshelf.reader.citationStyle": {
          "type": "string",
          "enum": [
            "pandoc",
            "latex",
            "author-year",
            "citekey"
          ],
          "enumDescriptions": [
            "> quote, then [@key, p. 12]",
            "``quote'' \\cite[p.~12]{key}",
            "\"quote\" (Silva et al., 2021, p. 12)",
            "quote @key"
          ],
          "default": "pandoc",
          "description": "Format used by Copy with Citation in the PDF reader."
        },
        "labshelf.reader.openBeside": {
          "type": "boolean",
          "default": false,
          "description": "Open the reader beside the current editor (split view). When disabled, the reader opens full-width in the active editor group."
        }
      }
    },
    "keybindings": [
      {
        "command": "labshelf.reader.zoomIn",
        "key": "ctrl+=",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+="
      },
      {
        "command": "labshelf.reader.zoomIn",
        "key": "ctrl+shift+=",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+shift+="
      },
      {
        "command": "labshelf.reader.zoomOut",
        "key": "ctrl+-",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+-"
      },
      {
        "command": "labshelf.reader.zoomReset",
        "key": "ctrl+0",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+0"
      },
      {
        "command": "labshelf.reader.find",
        "key": "ctrl+f",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+f"
      },
      {
        "command": "labshelf.reader.historyBack",
        "key": "alt+left",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "alt+left"
      },
      {
        "command": "labshelf.reader.historyForward",
        "key": "alt+right",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "alt+right"
      },
      {
        "command": "labshelf.reader.toggleSidebar",
        "key": "f4",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      },
      {
        "command": "labshelf.reader.historyBack",
        "key": "alt+left",
        "mac": "cmd+[",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      },
      {
        "command": "labshelf.reader.historyForward",
        "key": "alt+right",
        "mac": "cmd+]",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      },
      {
        "command": "labshelf.writing.showInPreview",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorLangId == latex"
      }
    ]
  },
  "scripts": {
    "compile": "pnpm run build",
    "build": "pnpm run build:host && pnpm run build:webview",
    "build:host": "node build/host.mjs",
    "build:webview": "node build/webviews.mjs",
    "watch": "node build/host.mjs --watch",
    "watch:webview": "node build/webviews.mjs --watch",
    "dev": "node build/host.mjs --watch & node build/webviews.mjs --watch & wait",
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p tsconfig.webview.json",
    "vscode:prepublish": "node build/host.mjs --production && node build/webviews.mjs --production",
    "lint": "node ../../scripts/run-eslint.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:core": "jest __tests__/core",
    "test:db": "jest __tests__/db",
    "test:storage": "jest __tests__/storage",
    "test:pdf": "jest __tests__/pdf",
    "test:bibtex": "jest __tests__/bibtex",
    "test:commands": "jest __tests__/commands"
  },
  "dependencies": {
    "@labshelf/core": "workspace:*",
    "@myriaddreamin/typst-ts-web-compiler": "0.7.0",
    "@napi-rs/canvas": "^1.0.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/vscode": "^1.98.0",
    "esbuild": "^0.24.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2",
    "typescript-js": "npm:typescript@^6.0.3"
  }
}
