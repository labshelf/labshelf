{
  "name": "@labshelf/vscode",
  "displayName": "LabShelf",
  "description": "Local-first research operating system for VS Code.",
  "version": "0.0.1",
  "publisher": "labshelf",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:**/labshelf.yaml",
    "onLanguage:latex",
    "onUri",
    "onStartupFinished"
  ],
  "contributes": {
    "configurationDefaults": {
      "[latex]": {
        "editor.wordWrap": "on"
      },
      "[typst]": {
        "editor.wordWrap": "on"
      }
    },
    "languages": [
      {
        "id": "typst",
        "aliases": [
          "Typst"
        ],
        "extensions": [
          ".typ"
        ],
        "configuration": "./language-configuration/typst.json",
        "icon": {
          "light": "./media/typst.png",
          "dark": "./media/typst.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "typst",
        "scopeName": "source.typst",
        "path": "./syntaxes/typst.tmLanguage.json"
      }
    ],
    "commands": [
