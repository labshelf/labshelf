          "command": "labshelf.collab.join"
        },
        {
          "command": "labshelf.collab.leave"
        },
        {
          "command": "labshelf.share.folder"
        },
        {
          "command": "labshelf.share.manage"
        },
        {
          "command": "labshelf.share.import"
        },
        {
          "command": "labshelf.relay.connect"
        },
        {
          "command": "labshelf.relay.disconnect"
        },
        {
          "command": "labshelf.relay.offer"
        },
        {
          "command": "labshelf.relay.withdraw"
        },
        {
          "command": "labshelf.collab.undo",
          "when": "false"
        },
        {
          "command": "labshelf.collab.redo",
          "when": "false"
        },
        {
          "command": "labshelf.moveLibrary"
        },
        {
          "command": "labshelf.templates.open"
        },
        {
          "command": "labshelf.templates.publish"
        },
        {
          "command": "labshelf.templates.saveProject"
        },
        {
          "command": "labshelf.writing.compareVersions"
        },
        {
          "command": "labshelf.writing.checkBeforeSubmitting"
        },
        {
          "command": "labshelf.writing.addExistingFolder"
        },
        {
          "command": "labshelf.comment.reply",
          "when": "false"
        },
        {
          "command": "labshelf.comment.resolve",
          "when": "false"
        },
        {
          "command": "labshelf.comment.reopen",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "labshelf.writing.showHistory",
          "when": "resourceLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject",
          "group": "navigation@1"
        },
        {
          "command": "labshelf.writing.insertSymbol",
          "when": "resourceLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject",
          "group": "navigation@3"
        },
        {
          "command": "labshelf.writing.insertTable",
          "when": "resourceLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject",
          "group": "navigation@4"
        },
        {
          "command": "labshelf.writing.insertImage",
          "when": "resourceLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject",
          "group": "navigation@5"
        },
        {
          "command": "labshelf.writing.searchInProject",
          "when": "resourceLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject",
          "group": "navigation@6"
        },
        {
          "command": "labshelf.writing.citeFromLibrary",
          "when": "resourceLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject",
          "group": "navigation@7"
        },
        {
          "command": "labshelf.writing.bold",
          "when": "resourceLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject",
          "group": "1_format@1"
        },
        {
          "command": "labshelf.writing.italic",
          "when": "resourceLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject",
          "group": "1_format@2"
        }
      ],
      "editor/context": [
        {
          "command": "labshelf.writing.showInPreview",
          "when": "editorLangId == latex",
          "group": "navigation@9"
        }
      ],
      "explorer/context": [
        {
          "command": "labshelf.writing.setMain",
          "when": "resourceExtname =~ /^\\.(tex|typ)$/",
          "group": "2_workspace@9"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "labshelf.comment.reply",
          "group": "inline",
          "when": "commentController == labshelf.comments"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "labshelf.comment.resolve",
          "group": "inline",
          "when": "commentController == labshelf.comments && commentThread == labshelf.thread.open"
        },
        {
          "command": "labshelf.comment.reopen",
          "group": "inline",
          "when": "commentController == labshelf.comments && commentThread == labshelf.thread.resolved"
        }
      ]
    },
    "configuration": {
      "title": "LabShelf",
      "properties": {
        "labshelf.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Index paper text so the Related tab can list similar papers."
        },
        "labshelf.ocr.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Read a PDF optically when its text layer is missing or unreadable, so scanned papers and files with damaged fonts still yield metadata. Only runs when the text layer fails."
        },
        "labshelf.ocr.makeSearchable": {
          "type": "boolean",
          "default": true,
          "description": "After importing a scanned paper, read every page and add an invisible text layer so the PDF can be searched (Ctrl+F) and its text selected. The pages themselves are not altered. Runs in the background; requires labshelf.ocr.enabled. When off, scans are still detected and flagged in the library, and can be made searchable from the paper's details."
        },
        "labshelf.ocr.maxPages": {
          "type": "number",
          "default": 150,
          "minimum": 1,
          "description": "Scanned documents with more pages than this are not given a text layer automatically, since each page takes several seconds to read."
        },
        "labshelf.ocr.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "eng"
          ],
          "description": "Tesseract language codes used for OCR, for example [\"eng\", \"por\"]. Language data is downloaded once on first use."
        },
        "labshelf.reader.vimKeys": {
          "type": "boolean",
          "default": false,
          "description": "Enable single-key vim navigation in the PDF reader (j/k, d/u, gg/G, /, n/N, H/L, w, t). Conventional shortcuts stay active."
        },
        "labshelf.reader.defaultZoom": {
          "type": "string",
          "enum": [
            "page-width",
            "page-fit",
            "page-actual",
            "auto"
          ],
          "default": "page-width",
          "description": "Zoom applied when a paper is opened without a stored reading position, and by Reset Zoom."
        },
        "labshelf.reader.toolbarAutoHide": {
          "type": "boolean",
          "default": true,
          "description": "Hide the reader toolbar while scrolling down; it returns on scroll up, when the pointer nears the top, or on keyboard focus."
        },
        "labshelf.reader.restorePosition": {
          "type": "boolean",
          "default": true,
          "description": "Reopen each paper at the page, zoom and sidebar state where it was last read."
        },
        "labshelf.reader.hoverPreviews": {
          "type": "boolean",
          "default": true,
          "description": "Show a preview when hovering a citation, figure, equation, table or section link."
        },
        "labshelf.reader.hoverDelayMs": {
          "type": "number",
          "default": 250,
          "minimum": 0,
          "maximum": 2000,
          "description": "Delay before a hover preview opens, in milliseconds."
        },
        "labshelf.reader.citationStyle": {
          "type": "string",
          "enum": [
            "pandoc",
            "latex",
            "author-year",
            "citekey"
          ],
          "enumDescriptions": [
            "> quote, then [@key, p. 12]",
            "``quote'' \\cite[p.~12]{key}",
            "\"quote\" (Silva et al., 2021, p. 12)",
            "quote @key"
          ],
          "default": "pandoc",
          "description": "Format used by Copy with Citation in the PDF reader."
        },
        "labshelf.reader.openBeside": {
          "type": "boolean",
          "default": false,
          "description": "Open the reader beside the current editor (split view). When disabled, the reader opens full-width in the active editor group."
        },
        "labshelf.writing.autoCompile": {
          "type": "string",
          "enum": ["typing", "save", "off"],
          "default": "typing",
          "description": "When the PDF preview compiles on its own.",
          "enumDescriptions": [
            "Save LaTeX sources a moment after you stop typing and compile; Typst previews follow typing.",
            "Compile when a project source is saved.",
            "Compile only with Build Project or Recompile."
          ]
        },
        "labshelf.writing.haltOnError": {
          "type": "boolean",
          "default": false,
          "description": "Stop a LaTeX build at the first error instead of compiling despite errors."
        }
      }
    },
    "keybindings": [
      {
        "command": "labshelf.reader.zoomIn",
        "key": "ctrl+=",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+="
      },
      {
        "command": "labshelf.reader.zoomIn",
        "key": "ctrl+shift+=",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+shift+="
      },
      {
        "command": "labshelf.reader.zoomOut",
        "key": "ctrl+-",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+-"
      },
      {
        "command": "labshelf.reader.zoomReset",
        "key": "ctrl+0",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+0"
      },
      {
        "command": "labshelf.reader.find",
        "key": "ctrl+f",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "cmd+f"
      },
      {
        "command": "labshelf.reader.historyBack",
        "key": "alt+left",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "alt+left"
      },
      {
        "command": "labshelf.reader.historyForward",
        "key": "alt+right",
        "when": "activeWebviewPanelId == 'labshelfPdf'",
        "mac": "alt+right"
      },
      {
        "command": "labshelf.reader.toggleSidebar",
        "key": "f4",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      },
      {
        "command": "labshelf.reader.historyBack",
        "key": "alt+left",
        "mac": "cmd+[",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      },
      {
        "command": "labshelf.reader.historyForward",
        "key": "alt+right",
        "mac": "cmd+]",
        "when": "activeWebviewPanelId == 'labshelfPdf'"
      },
      {
        "command": "labshelf.writing.showInPreview",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "editorLangId == latex"
      },
      {
        "command": "labshelf.writing.build",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject"
      },
      {
        "command": "labshelf.writing.searchInProject",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus && editorLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject"
      },
      {
        "command": "labshelf.writing.bold",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && editorLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject"
      },
      {
        "command": "labshelf.writing.italic",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && editorLangId =~ /^(latex|typst)$/ && labshelf.writing.inProject"
      },
      {
        "command": "labshelf.collab.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "editorTextFocus && !editorReadonly && labshelf.collab.sharedEditor"
      },
      {
        "command": "labshelf.collab.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "editorTextFocus && !editorReadonly && labshelf.collab.sharedEditor"
      },
      {
        "command": "labshelf.collab.redo",
        "key": "ctrl+shift+z",
        "when": "editorTextFocus && !editorReadonly && labshelf.collab.sharedEditor"
      }
    ]
  },
  "scripts": {
    "compile": "pnpm run build",
    "build": "pnpm run build:host && pnpm run build:webview",
    "build:host": "node build/host.mjs",
    "build:webview": "node build/webviews.mjs",
    "watch": "node build/host.mjs --watch",
    "watch:webview": "node build/webviews.mjs --watch",
    "dev": "node build/host.mjs --watch & node build/webviews.mjs --watch & wait",
    "typecheck": "tsc --noEmit -p ./ && tsc --noEmit -p tsconfig.webview.json",
    "vscode:prepublish": "node build/host.mjs --production && node build/webviews.mjs --production",
    "lint": "node ../../scripts/run-eslint.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:core": "jest __tests__/core",
    "test:db": "jest __tests__/db",
    "test:storage": "jest __tests__/storage",
    "test:pdf": "jest __tests__/pdf",
    "test:bibtex": "jest __tests__/bibtex",
    "test:commands": "jest __tests__/commands"
  },
