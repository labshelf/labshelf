<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
  <title>LabShelf Helper</title>
  <domains enable_anywhere="false" enable_currentUserHome="true" enable_localSystem="false"/>
  <conclusion file="conclusion.txt"/>
  <options customize="allow" require-scripts="false" hostArchitectures="HOST_ARCH"/>
  <choices-outline>
    <line choice="default">
      <line choice="python"/>
    </line>
  </choices-outline>
  <choice id="default" title="LabShelf Helper">
    <pkg-ref id="dev.labshelf.helper"/>
  </choice>
  <choice id="python" title="Python for calculations" description="Installs Python so notes can run calculations." start_selected="false">
    <pkg-ref id="dev.labshelf.helper.python"/>
  </choice>
  <pkg-ref id="dev.labshelf.helper" version="VERSION">component.pkg</pkg-ref>
  <pkg-ref id="dev.labshelf.helper.python" version="VERSION">python.pkg</pkg-ref>
</installer-gui-script>
