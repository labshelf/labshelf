{
  "name": "@labshelf/browser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node build/build.mjs",
    "build:chrome": "node build/build.mjs --target=chrome",
    "build:firefox": "node build/build.mjs --target=firefox",
    "dev:firefox": "node build/build.mjs --target=firefox && web-ext run --source-dir=dist/firefox",
    "package:firefox": "node build/build.mjs --target=firefox && web-ext build --source-dir=dist/firefox --artifacts-dir=dist/xpi --filename labshelf-{version}.xpi --overwrite-dest",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "node ../../scripts/lint/eslint.mjs",
    "lint:manifest": "web-ext lint --source-dir=dist/firefox --self-hosted",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@labshelf/core": "workspace:*",
    "idb": "^8.0.0",
    "node-diff3": "^3.2.1",
    "pdfjs-dist": "~6.3.289",
    "webextension-polyfill": "^0.12.0",
    "y-codemirror.next": "^0.3.6",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.24.0",
    "fake-indexeddb": "^6.2.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2",
    "typescript-js": "npm:typescript@^6.0.3",
    "web-ext": "^8.0.0"
  }
}
