{
  "manifest_version": 3,
  "name": "LabShelf",
  "version": "0.1.0",
  "description": "Local-first research paper manager.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "labshelf@lucanaasser.dev",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+labshelf",
      "name": "LabShelf",
      "uriTemplate": "/library-page/index.html?link=%s"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://api.crossref.org/*",
    "https://api.unpaywall.org/*",
    "https://eutils.ncbi.nlm.nih.gov/*",
    "https://export.arxiv.org/*",
    "https://arxiv.org/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": [
      "background/index.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "include_globs": [
        "https://scholar.google.*/scholar*"
      ],
      "js": [
        "content/scholar.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    },
    "default_popup": "popup/index.html",
    "default_title": "LabShelf"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "library-page/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; upgrade-insecure-requests;"
  }
}
