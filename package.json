{
  "name": "labshelf-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:vscode": "pnpm --filter @labshelf/vscode dev",
    "build:vscode": "pnpm --filter @labshelf/vscode build",
    "lint": "pnpm -r lint && pnpm run lint:deps && pnpm run knip && pnpm run jscpd && pnpm run lint:dirs",
    "lint:deps": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "lint:dirs": "node scripts/check-directory-size.mjs",
    "knip": "knip",
    "jscpd": "node scripts/summarize-jscpd.mjs",
    "jscpd:update-baseline": "node scripts/summarize-jscpd.mjs --update"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "jscpd": "^5.4.1",
    "knip": "^6.40.0",
    "typescript-eslint": "^8.71.1"
  }
}
