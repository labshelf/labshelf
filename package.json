{
  "name": "labshelf-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:tooling": "node --test \"scripts/*/__tests__/*.test.mjs\" \".claude/tools/agentTranscripts/__tests__/*.test.mjs\"",
    "dev:vscode": "pnpm --filter @labshelf/vscode dev",
    "build:vscode": "pnpm --filter @labshelf/vscode build",
    "lint": "pnpm -r lint && pnpm run lint:deps && pnpm run knip && pnpm run jscpd && pnpm run lint:dirs && pnpm run lint:naming --all --verbose && pnpm run lint:words",
    "lint:deps": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "lint:dirs": "node scripts/checks/directorySize.mjs",
    "lint:words": "node scripts/checks/bannedWords.mjs",
    "lint:naming": "node scripts/checks/naming.mjs",
    "knip": "knip",
    "jscpd": "node scripts/checks/duplicates.mjs",
    "jscpd:update-baseline": "node scripts/checks/duplicates.mjs --update",
    "verify:library": "sh scripts/verify/library/run.sh"
  },
  "devDependencies": {
    "boring-avatars-vanilla": "1.0.2",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.12.0",
    "jscpd": "^5.4.1",
    "knip": "^6.40.0",
    "playwright-core": "1.64.1",
    "typescript-eslint": "^8.71.1"
  }
}
