{
  "name": "labshelf-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:tooling": "node --test \"scripts/*/__tests__/*.test.mjs\" \"tools/*/__tests__/*.test.mjs\" \".claude/hooks/__tests__/*.test.mjs\"",
    "dev:vscode": "pnpm --filter @labshelf/vscode dev",
    "build:vscode": "pnpm --filter @labshelf/vscode build",
    "lint": "pnpm -r lint && pnpm run lint:deps && pnpm run knip && pnpm run jscpd && pnpm run lint:modules && pnpm run lint:rules && pnpm run lint:words",
    "lint:deps": "depcruise packages/*/src --config scripts/lint/dependencyCruiser.cjs",
    "lint:modules": "node scripts/lint/modules.mjs",
    "lint:rules": "node scripts/lint/sourceRules.mjs",
    "lint:words": "node scripts/lint/bannedWords.mjs",
    "knip": "knip --config scripts/lint/knip.json",
    "jscpd": "node scripts/lint/duplicates.mjs",
    "jscpd:update-baseline": "node scripts/lint/duplicates.mjs --update",
    "gate": "node scripts/lint/gate.mjs",
    "plan:run": "node scripts/plans/runPlan.mjs",
    "verify:library": "sh scripts/verify/library/run.sh"
  },
  "devDependencies": {
    "boring-avatars-vanilla": "1.0.2",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.24.0",
    "eslint": "^10.12.0",
    "jscpd": "^5.4.1",
    "knip": "^6.40.0",
    "playwright-core": "1.64.1",
    "typescript-eslint": "^8.71.1"
  }
}
