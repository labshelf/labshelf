{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*/*.mjs",
        "scripts/verify/library/shoot.mjs",
        "tools/*/*.mjs"
      ],
      "project": [
        "scripts/*/*.mjs",
        "scripts/verify/library/*.mjs",
        "tools/*/*.mjs"
      ],
      "ignoreBinaries": [
        "tsc"
      ],
      "ignoreDependencies": [
        "boring-avatars-vanilla",
        "oxc-parser",
        "oxc-resolver"
      ]
    },
    "packages/core": {
      "entry": [
        "src/bridge/node/hostEntry.ts",
        "__tests__/**/*.ts"
      ],
      "ignoreBinaries": [
        "pdflatex",
        "pdftotext",
        "reg",
        "perl",
        "biber"
      ],
      "project": [
        "src/**/*.ts",
        "__tests__/**/*.ts"
      ],
      "ignoreDependencies": [
        "@napi-rs/canvas",
        "prosemirror-commands",
        "prosemirror-history",
        "prosemirror-inputrules",
        "prosemirror-keymap",
        "prosemirror-state",
        "prosemirror-transform",
        "prosemirror-view",
        "y-prosemirror",
        "@vscode/codicons"
      ]
    },
    "packages/vscode": {
      "entry": [
        "src/extension.ts",
        "src/node/helperHost.ts",
        "src/reader/webview/readerEntry.ts",
        "src/libraryUi/webview/libraryEntry.ts",
        "src/libraryUi/webview/detailsEntry.ts",
        "src/writing/templates/webview/galleryEntry.ts",
        "src/libraryUi/webview/sidebarEntry.ts",
        "src/writing/search/webview/searchEntry.ts",
        "src/writing/history/webview/historyEntry.ts",
        "src/writing/webview/allProjectsEntry.ts",
        "src/writing/typst/index.ts",
        "src/library/webview/syncGuideEntry.ts",
        "src/spaces/webview/researchChatEntry.ts",
        "src/spaces/webview/spacesEntry.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "ignoreBinaries": [
        "wait"
      ],
      "ignoreDependencies": [
        "@napi-rs/canvas",
        "pdf-lib",
        "pdfjs-dist",
        "tesseract.js",
        "@vscode/test-web"
      ]
    },
    "packages/browser": {
      "entry": [
        "src/background/entry.ts",
        "src/popup/entry.ts",
        "src/options/entry.ts",
        "src/libraryUi/libraryPage.ts",
        "src/libraryUi/reader/readerPage.ts",
        "src/capture/offscreen.ts",
        "src/platform/themeStartup.ts",
        "src/content/entry.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "ignoreDependencies": [
        "@fontsource/*",
        "jest-environment-jsdom"
      ]
    },
    "packages/terminal": {
      "entry": [
        "src/terminalEntry.ts",
        "src/helper/helperEntry.ts",
        "src/helperHost.ts",
        "src/libraryUi/thumbnailWorker.ts",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "ignoreBinaries": [
        "pdftoppm"
      ],
      "ignoreDependencies": [
        "@napi-rs/canvas",
        "pdfjs-dist",
        "tesseract.js"
      ]
    },
    "website": {
      "entry": [
        "js/main.js",
        "js/connected.js",
        "src/demos/library.ts",
        "src/demos/reader.ts",
        "src/share.ts",
        "build/*.mjs",
        "tools/*.mjs",
        "__tests__/**/*.ts"
      ],
      "project": [
        "js/**/*.js",
        "src/**/*.ts",
        "build/*.mjs",
        "tools/*.mjs",
        "__tests__/**/*.ts"
      ]
    }
  }
}
