{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/verify-library/shoot.mjs"
      ],
      "project": [
        "scripts/*.mjs",
        "scripts/verify-library/*.mjs"
      ],
      "ignoreBinaries": [
        "tsc"
      ]
    },
    "packages/core": {
      "entry": [
        "__tests__/**/*.ts"
      ],
      "ignoreBinaries": [
        "pdflatex",
        "pdftotext"
      ],
      "project": [
        "src/**/*.ts",
        "__tests__/**/*.ts"
      ],
      "ignoreDependencies": [
        "@napi-rs/canvas"
      ]
    },
    "packages/vscode": {
      "entry": [
        "src/extension.ts",
        "src/reader/main.ts",
        "src/libraryWebview/main.ts",
        "src/writing/templates/webview/main.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "ignoreBinaries": [
        "wait"
      ],
      "ignoreDependencies": [
        "@napi-rs/canvas",
        "pdf-lib",
        "pdfjs-dist",
        "tesseract.js"
      ]
    },
    "packages/browser": {
      "entry": [
        "src/background/index.ts",
        "src/popup/index.ts",
        "src/options/index.ts",
        "src/library-page/main.ts",
        "src/pdfText/offscreen.ts",
        "src/reader/index.ts",
        "src/ui/themeBoot.ts",
        "src/content/scholar.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ]
    },
    "packages/terminal": {
      "entry": [
        "src/main.ts",
        "src/preview/thumbnailWorker.ts",
        "__tests__/**/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "build/*.mjs",
        "__tests__/**/*.ts"
      ],
      "ignoreBinaries": [
        "pdftoppm",
        "secret-tool"
      ],
      "ignoreDependencies": [
        "@napi-rs/canvas",
        "pdfjs-dist",
        "tesseract.js"
      ]
    },
    "website": {
      "entry": [
        "js/main.js",
        "src/demos/library.ts",
        "src/demos/reader.ts",
        "build/*.mjs",
        "tools/*.mjs",
        "__tests__/**/*.ts"
      ],
      "project": [
        "js/**/*.js",
        "src/**/*.ts",
        "build/*.mjs",
        "tools/*.mjs",
        "__tests__/**/*.ts"
      ]
    }
  }
}
