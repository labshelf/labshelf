// Serves the website as static assets from a Worker on labshelf.org; `.assetsignore` keeps sources, tests and build scripts out.
{
  "name": "labshelf-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "labshelf.org", "custom_domain": true },
    { "pattern": "www.labshelf.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
