// The website Worker on labshelf.org: static assets for every path (`.assetsignore` keeps sources, tests, migrations and build scripts out),
// and the directory API (documents/contracts/directory.md) for /api/* only, over the D1 database bound as DB.
// Deployed by hand: documents/contracts/directory.md#deploy.
{
  "name": "labshelf-website",
  "main": "src/directory/index.ts",
  "compatibility_date": "2026-10-01",
  // dist/ (the share page, the demos and pdf.js) is not committed; building first keeps a deploy from a fresh checkout or worktree from publishing pages without their scripts.
  "build": { "command": "pnpm run build" },
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "labshelf-directory",
      "database_id": "9adc864d-a6e6-420c-9713-2e865e92d163",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "labshelf.org", "custom_domain": true },
    { "pattern": "www.labshelf.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
