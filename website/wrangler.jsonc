// The website Worker on labshelf.org: static assets for every path (`.assetsignore` keeps sources, tests, migrations and build scripts out),
// the directory API (documents/contracts/directory.md) for /api/* only, over the D1 database bound as DB,
// and the browser LaTeX engine's files for /busytex/* from the R2 bucket bound as ASSETS_BUCKET (uploaded by tools/uploadBusytex.mjs).
// First setup by hand, then deployed by .github/workflows/website-deploy.yml on every push to main that changes the site: documents/contracts/directory.md#deploy.
{
  "name": "labshelf-website",
  "main": "src/directory/index.ts",
  "compatibility_date": "2026-10-01",
  // dist/ (the share page, the demos and pdf.js) is not committed; building first keeps a deploy from a fresh checkout or worktree from publishing pages without their scripts.
  "build": { "command": "pnpm run build" },
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/busytex/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "labshelf-directory",
      "database_id": "9adc864d-a6e6-420c-9713-2e865e92d163",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "labshelf-assets" }
  ],
  "routes": [
    { "pattern": "labshelf.org", "custom_domain": true },
    { "pattern": "www.labshelf.org", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
